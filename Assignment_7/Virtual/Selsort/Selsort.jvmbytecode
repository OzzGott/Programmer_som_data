// Local variables:  local 0 = arr,  local 1 = i,  local 2 = least,  local 3 = j and tmp

  public static void SelectionSort(int[]);
    descriptor: ([I)V
    flags: (0x0009) ACC_PUBLIC, ACC_STATIC
    Code:
      stack=4, locals=4, args_size=1

      // i = 0
         0: iconst_0
         1: istore_1

      // outer loop test: exit the loop if i >= arr.length
         2: iload_1
         3: aload_0
         4: arraylength
         5: if_icmpge     57

      // least = i
         8: iload_1
         9: istore_2

      // j = i + 1
        10: iload_1
        11: iconst_1
        12: iadd
        13: istore_3

      // inner loop test: exit the loop if j >= arr.length
        14: iload_3
        15: aload_0
        16: arraylength
        17: if_icmpge     37

      // if (arr[j] < arr[least]): load both elements and skip
      // the assignment if arr[j] >= arr[least]
        20: aload_0
        21: iload_3
        22: iaload
        23: aload_0
        24: iload_2
        25: iaload
        26: if_icmpge     31

      // least = j
        29: iload_3
        30: istore_2

      // j++ (iinc adds to the local directly, without using the stack),
      // then jump back to the inner loop test
        31: iinc          3, 1
        34: goto          14

      // tmp = arr[i] (stored in slot 3, which j used before)
        37: aload_0
        38: iload_1
        39: iaload
        40: istore_3

      // arr[i] = arr[least]: push array and index first, then the value
        41: aload_0
        42: iload_1
        43: aload_0
        44: iload_2
        45: iaload
        46: iastore

      // arr[least] = tmp
        47: aload_0
        48: iload_2
        49: iload_3
        50: iastore

      // i++, then jump back to the outer loop test
        51: iinc          1, 1
        54: goto          2

        57: return
